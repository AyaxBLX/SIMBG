@page "/estudiantes"
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using Blazored.LocalStorage
@using Microsoft.AspNetCore.Authorization

@* ¡El Cadenero del Frontend! Solo los Administradores pueden ver esta página *@
@attribute [Authorize(Roles = "Administrador")]

@inject HttpClient Http
@inject ILocalStorageService LocalStorage
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    <MudText Typo="Typo.h4" Color="Color.Primary" Class="mb-4">Gestión de Estudiantes</MudText>

    <MudGrid>
        <MudItem xs="12" md="4">
            <MudCard Elevation="3">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Registrar Nuevo Alumno</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudForm @ref="form">
                        <MudTextField @bind-Value="nuevoEstudiante.Matricula" Label="Matrícula" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                        <MudTextField @bind-Value="nuevoEstudiante.Nombre" Label="Nombre(s)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                        <MudTextField @bind-Value="nuevoEstudiante.ApellidoPaterno" Label="Apellido Paterno" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                        <MudTextField @bind-Value="nuevoEstudiante.ApellidoMaterno" Label="Apellido Materno" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                    </MudForm>
                </MudCardContent>
                <MudCardActions Class="d-flex justify-end pb-4 pr-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GuardarEstudiante" Disabled="@_guardando">
                        @if (_guardando)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" Color="Color.Surface" />
                        }
                        else
                        {
                            <span>Guardar</span>
                        }
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="8">
            <MudTable Items="@listaEstudiantes" Hover="true" Loading="@_cargando" Elevation="3">
                <HeaderContent>
                    <MudTh>ID BD</MudTh>
                    <MudTh>Matrícula</MudTh>
                    <MudTh>Nombre Completo</MudTh>
                    <MudTh>Acciones</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="ID BD">@context.Id</MudTd>
                    <MudTd DataLabel="Matrícula">@context.Matricula</MudTd>
                    <MudTd DataLabel="Nombre Completo">@context.Nombre @context.ApellidoPaterno @context.ApellidoMaterno</MudTd>
                    <MudTd DataLabel="Acciones">
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Secondary">Enrolar Huella</MudButton>
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager RowsPerPageString="Filas por página:" />
                </PagerContent>
            </MudTable>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private bool _cargando = true;
    private bool _guardando = false;
    private MudForm form = default!;
    private List<EstudianteDTO> listaEstudiantes = new List<EstudianteDTO>();
    private NuevoEstudianteDTO nuevoEstudiante = new NuevoEstudianteDTO();

    // Actualiza esta URL según tu túnel actual
    private string urlApi = "https://f3hnv5m6-7202.usw3.devtunnels.ms/api/Estudiantes";

    protected override async Task OnInitializedAsync()
    {
        await CargarEstudiantes();
    }

    private async Task PrepararAutenticacion()
    {
        // 1. Sacamos el Token de la mochila del navegador
        var token = await LocalStorage.GetItemAsync<string>("tokenJwt");

        // 2. Se lo pegamos al HttpClient en el encabezado de "Authorization: Bearer <token>"
        if (!string.IsNullOrEmpty(token))
        {
            Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        }
    }

    private async Task CargarEstudiantes()
    {
        _cargando = true;
        try
        {
            await PrepararAutenticacion();
            var respuesta = await Http.GetFromJsonAsync<List<EstudianteDTO>>($"{urlApi}/lista");
            if (respuesta != null)
            {
                listaEstudiantes = respuesta;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error al cargar la lista de estudiantes. Verifica tu conexión.", Severity.Error);
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task GuardarEstudiante()
    {
        _guardando = true;
        try
        {
            await PrepararAutenticacion();
            var respuesta = await Http.PostAsJsonAsync($"{urlApi}/nuevo", nuevoEstudiante);

            if (respuesta.IsSuccessStatusCode)
            {
                Snackbar.Add("Estudiante registrado con éxito.", Severity.Success);
                nuevoEstudiante = new NuevoEstudianteDTO(); // Limpiamos el formulario
                await CargarEstudiantes(); // Recargamos la tabla
            }
            else
            {
                var error = await respuesta.Content.ReadAsStringAsync();
                Snackbar.Add($"Error: {error}", Severity.Error);
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Error al guardar el estudiante.", Severity.Error);
        }
        finally
        {
            _guardando = false;
        }
    }

    // Clases DTO locales para el Frontend
    public class EstudianteDTO
    {
        public int Id { get; set; }
        public string Matricula { get; set; } = string.Empty;
        public string Nombre { get; set; } = string.Empty;
        public string ApellidoPaterno { get; set; } = string.Empty;
        public string ApellidoMaterno { get; set; } = string.Empty;
    }

    public class NuevoEstudianteDTO
    {
        public string Matricula { get; set; } = string.Empty;
        public string Nombre { get; set; } = string.Empty;
        public string ApellidoPaterno { get; set; } = string.Empty;
        public string ApellidoMaterno { get; set; } = string.Empty;
    }
}