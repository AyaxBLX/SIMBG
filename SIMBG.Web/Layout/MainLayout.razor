@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using SIMBG.Web.Auth
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navegador
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

<CascadingAuthenticationState>
    <MudThemeProvider Theme="miTemaInstitucional" />
    <MudDialogProvider />
    <MudSnackbarProvider />
    <MudPopoverProvider />

    <MudLayout>
        <MudAppBar Elevation="1">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@DrawerToggle" />
            <MudText Typo="Typo.h5" Class="ml-3">Sistema SIMBG</MudText>
            <MudSpacer />

            <AuthorizeView>
                <Authorized>
                    <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="CerrarSesion">Cerrar Sesión</MudButton>
                </Authorized>
            </AuthorizeView>
        </MudAppBar>

        <MudDrawer @bind-Open="_drawerOpen" Elevation="2">
            <MudDrawerHeader>
                <MudText Typo="Typo.h6" Align="Align.Center" Color="Color.Primary"><strong>TESOEM</strong></MudText>
            </MudDrawerHeader>
            <MudNavMenu>
                <MudNavLink Href="/" Icon="@Icons.Material.Filled.Dashboard">Mi Perfil</MudNavLink>
                <MudNavLink Href="/documentos" Icon="@Icons.Material.Filled.Folder">Gestor Documental</MudNavLink>
                <MudNavLink Href="/bitacora" Icon="@Icons.Material.Filled.AccessTime">Bitácora</MudNavLink>

                <AuthorizeView Roles="Administrador">
                    <Authorized>
                        <MudNavLink Href="/estudiantes" Icon="@Icons.Material.Filled.People">Estudiantes</MudNavLink>
                    </Authorized>
                </AuthorizeView>

            </MudNavMenu>
        </MudDrawer>

        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-4">
                @Body
            </MudContainer>
        </MudMainContent>
    </MudLayout>
</CascadingAuthenticationState>

@code {
    bool _drawerOpen = true;

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    // La lógica real para destruir el gafete y salir
    private async Task CerrarSesion()
    {
        await LocalStorage.RemoveItemAsync("tokenJwt");
        ((ProveedorAutenticacionJWT)AuthProvider).NotificarUsuarioDeslogueado();
        Navegador.NavigateTo("/login");
    }

    //paleta de colores institucional
    MudTheme miTemaInstitucional = new MudTheme()
        {
            PaletteLight = new PaletteLight()
            {
            //este color afectará botones primarios, líneas, etc
                Primary = "#9D2449",

            //color dorado para botones secundarios, acentos, etc
                Secondary = "#B38E5D",

            // color de barra superior
                AppbarBackground = "#9D2449",

            //color de texto en la barra superior
                AppbarText = "#FFFFFF",

            //fondo grisd para que tarjetas blancas resalten
                Background = "#F5F5F5",

            //color de íconos del menú cuando se seleccionan
                DrawerIcon = "#9D2449",
            }
        };

}